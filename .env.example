# Smart Mirror — Environment Variables
# Copy this to .env and fill in your values

# ── Server ───────────────────────────────
PORT=3000

# ── Dreeve fitness data (preferred) ──────
# Base URL of your Dreeve site, with no trailing slash. The mirror reads
# Dreeve's generated activity JSON and does not need a working Strava API app.
DREEVE_URL=http://192.168.1.50:8080
DREEVE_ACTIVITIES_PATH=/api/activity/data-table.json
# Comma-separated Dreeve sport types to include in the mirror's walking stats.
DREEVE_SPORT_TYPES=Walk
DREEVE_CACHE_SECONDS=300

# ── Direct Strava fallback ───────────────
# Used only when DREEVE_URL is blank.
# Get these from https://www.strava.com/settings/api
# Steps:
#   1. Create an app at strava.com/settings/api
#   2. Set Authorization Callback Domain to: localhost
#   3. Run: node scripts/strava-auth.js  to get your refresh token
STRAVA_CLIENT_ID=your_client_id
STRAVA_CLIENT_SECRET=your_client_secret
STRAVA_REFRESH_TOKEN=your_refresh_token

# ── Immich ───────────────────────────────
# Your local Immich server URL (no trailing slash)
IMMICH_URL=http://192.168.200.119:2283
# Generate an API key in Immich: Account Settings → API Keys
IMMICH_API_KEY=your_immich_api_key
# The album ID where mirror selfies are stored
# Find it in the Immich URL when viewing the album
IMMICH_ALBUM_ID=your_album_uuid

# ── Camera ───────────────────────────────
# The webcam is opened during the five-second countdown. This delay begins
# after fswebcam initializes it; 4 seconds is a practical Pi 2B starting point.
CAMERA_COUNTDOWN_DELAY_SECONDS=4
CAMERA_SKIP_FRAMES=1
CAMERA_RESOLUTION=1280x720
CAMERA_JPEG_QUALITY=95

# ── Display / LED Schedule ──────────────────
# Options: schedule, motion, always
DISPLAY_MODE=schedule
# IANA timezone name. This handles EST/EDT changes automatically.
SCHEDULE_TIMEZONE=America/New_York
# Each day accepts one or more comma-separated 24-hour time windows.
# The end time is the first OFF minute. Use "off" for the whole day or
# "all-day" for 24 hours. Overnight periods must be split across two days.
SCHEDULE_MON=05:00-21:00
SCHEDULE_TUE=05:00-21:00
SCHEDULE_WED=05:00-21:00
SCHEDULE_THU=05:00-21:00
SCHEDULE_FRI=05:00-21:00
# Example weekend hours; change these to the hours you actually want.
SCHEDULE_SAT=07:00-22:00
SCHEDULE_SUN=07:00-21:00
# Multiple ON periods example: SCHEDULE_SAT=07:00-12:00,17:00-22:00

# ── Optional Motion Sensor (HC-SR501 PIR) ────────────
# Legacy compatibility setting. DISPLAY_MODE takes priority when it is set.
MOTION_ENABLED=false
# GPIO pin (BCM numbering) the PIR sensor's OUT pin is wired to
MOTION_GPIO_PIN=17
# How many seconds after the last detected motion before the mirror goes to sleep
MOTION_GRACE_SECONDS=45
# While the PIR output remains HIGH, refresh the server this often
MOTION_HEARTBEAT_SECONDS=5
MOTION_POLL_SECONDS=0.25
# URL the motion_sensor.py daemon uses to reach this server (usually localhost)
MIRROR_URL=http://localhost:3000
